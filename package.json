{
  "name": "slowverb",
  "version": "0.1.0",
  "description": "Drop-in music player with speed and reverb",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --mac --dir",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy": "./scripts-deploy.sh",
    "live": "electron-vite dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.6.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "music-metadata": "^12.3.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "productName": "Slowverb",
  "build": {
    "appId": "com.ng.slowverb",
    "productName": "Slowverb",
    "files": [
      "out/**"
    ],
    "mac": {
      "target": "dir",
      "category": "public.app-category.music",
      "identity": null,
      "icon": "build/icon.icns"
    }
  }
}